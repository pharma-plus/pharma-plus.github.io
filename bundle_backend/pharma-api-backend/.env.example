# ============================================================
# PHARMA MAROC GOLD ENTERPRISE V2.0 — Configuration API
# Copier ce fichier en `.env` puis adapter les valeurs.
# ============================================================

# Serveur
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Base de données PostgreSQL
DATABASE_URL=postgresql://pharma:pharma@localhost:5432/pharma_maroc_gold

# Sécurité
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
SESSION_INACTIVITY_MINUTES=120

# 2FA
OTP_ISSUER=Pharma Maroc Gold

# Stockage fichiers (dossier local ; S3 via STORAGE_DRIVER=s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Sauvegardes
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=change-me-backup-encryption-key

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pharma Maroc Gold <no-reply@pharmamarocgold.com>"
FIREBASE_SERVER_KEY=
SMS_PROVIDER=none          # none | easysendsms | twilio
SMS_API_KEY=
SMS_SENDER=
WHATSAPP_PROVIDER=none     # none | 360dialog | twilio

# CORS (liste blanche)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Super administrateur initial
SUPER_ADMIN_EMAIL=admin@pharmamarocgold.com
SUPER_ADMIN_PASSWORD=ChangeMe_123!
